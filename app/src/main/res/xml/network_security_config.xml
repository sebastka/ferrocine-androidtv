<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers: plain http on the local network is allowed (the app warns
     about it), and certificates of a CA the user installed are trusted. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration,AcceptsUserCertificates">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
